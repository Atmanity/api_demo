# Your secret key from https://atmee.ai/studio/api-keys. Never expose this
# to a browser -- server.mjs keeps it server-side and never sends it to the page.
ATMEE_API_KEY=sk_atmee_...

# The id of an avatar your account owns.
ATMEE_AVATAR_ID=

# Optional. Only set this if you're testing against a non-production
# session_service (e.g. a local or staging instance). Leave it unset for a
# real integration.
# ATMEE_API_BASE_URL=https://api.atmanity.us
